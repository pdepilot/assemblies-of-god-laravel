APP_NAME="AG IKENEGBU Church ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_BRAND_NAME="AGC IKENEGBU"
ADMIN_BRAND_SUBTITLE="Church Management System"
ADMIN_PAGE_TITLE_SUFFIX="AGC IKENEGBU CMS"
ADMIN_LOGIN_TITLE="Administrator Portal"
ADMIN_LOGIN_PRIMARY_LABEL="AGC IKENEGBU"
ADMIN_LOGIN_PRIMARY_SUBTITLE="Church Management Platform"
ADMIN_LOGIN_SECONDARY_LABEL="Send Down Thy Glory"
ADMIN_LOGIN_SECONDARY_SUBTITLE="Event Management Platform"
ADMIN_FAVICON_PATH=images/ag-logo.jpeg
ADMIN_PRIMARY_LOGO_VIDEO_PATH=videos/Create_a_cinematic_D_animatio.mp4
ADMIN_SECONDARY_LOGO_VIDEO_PATH=sdgt/videos/3d-logo.mp4

# Phase 2 auth: platform_access on admins is ag|sdtg|both (default both)
# SDTG login: /admin/sdtg/login (guard: sdtg)

PUBLIC_SITE_AUTHOR="AG Ikenebgu Assemblies of God"
PUBLIC_SITE_NAME="AG Ikenebgu Assemblies of God"
PUBLIC_SITE_SHORT_NAME="AG Ikenebgu"
PUBLIC_SITE_TAGLINE="Assemblies of God Church Owerri"
PUBLIC_SITE_DEFAULT_TITLE="AG Ikenebgu | Assemblies of God Church Owerri - Worship & Community"
PUBLIC_SITE_DEFAULT_DESCRIPTION="AG Ikenebgu Assemblies of God in Owerri, Nigeria - spirit-filled worship, Bible teaching, family ministries, and community outreach. Join us Sundays 8:00 AM & 10:30 AM."
PUBLIC_SITE_DEFAULT_OG_TITLE="AG Ikenebgu | Assemblies of God Church Owerri"
PUBLIC_SITE_DEFAULT_OG_DESCRIPTION="Spirit-filled worship, Bible teaching, and community outreach in Owerri, Nigeria."
PUBLIC_SITE_LOGO_PATH=images/ag-logo.jpeg
PUBLIC_SITE_LOGO_VIDEO_PATH=videos/Create_a_cinematic_D_animatio.mp4
PUBLIC_SITE_WELCOME_VIDEO_PATH=videos/Create_a_cinematic_D_animatio.mp4
PUBLIC_SITE_WELCOME_VIDEO_LABEL="AG Ikenebgu welcome video"
PUBLIC_SITE_SDTG_LABEL="Send Down Thy Glory"

BRAND_EMAIL_FROM_NAME="Assemblies of God Church Ikenegbu"
BRAND_EMAIL_FROM_EMAIL=info@agikenebgu.org
BRAND_EMAIL_CHURCH_ADDRESS="11 Archdeacon, Dennis Street, Ikenegbu, Owerri, Imo State"
BRAND_EMAIL_CHURCH_PHONE="+234 800 000 0000"
BRAND_EMAIL_CHURCH_WEBSITE="${APP_URL}"
BRAND_EMAIL_PASTOR_NAME="Pastor Emmanuel"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assemblies_of_god
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Site traffic beacon (legacy public site → Laravel API during staging cutover)
TRAFFIC_IP_SALT=ag-ikenebgu-site-traffic-v1
TRAFFIC_GEO_LOOKUP=false
# Comma-separated origins allowed to POST /api/track-traffic (use * for staging)
TRAFFIC_BEACON_CORS_ORIGINS=*

PORTAL_MEDIA_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE
PORTAL_LEGACY_ADMIN_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE/portal
PORTAL_LEGACY_PUBLIC_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE
PORTAL_LEGACY_API_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE/api
PORTAL_LEGACY_ROOT=C:/xampp/htdocs/AG_IKENEGBU_CHURCH_WEBSITE
# PORTAL_WEBSITE_PAGES_PATH=C:/xampp/htdocs/AG_IKENEGBU_CHURCH_WEBSITE/portal/storage/website-pages.json
