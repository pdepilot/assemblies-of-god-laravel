APP_NAME="AGC IKENEGBU Church ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_BRAND_NAME="AGC IKENEGBU"
ADMIN_BRAND_SUBTITLE="Church Management System"
ADMIN_PAGE_TITLE_SUFFIX="AGC IKENEGBU"
ADMIN_LOGIN_TITLE="Administrator Portal"
ADMIN_LOGIN_PRIMARY_LABEL="AGC IKENEGBU"
ADMIN_LOGIN_PRIMARY_SUBTITLE="Church Management Platform"
ADMIN_FAVICON_PATH=images/ag-logo.jpeg
ADMIN_PRIMARY_LOGO_VIDEO_PATH=videos/Create_a_cinematic_D_animatio.mp4
ADMIN_SEARCH_PLACEHOLDER="Search members, events, pages..."

PUBLIC_SITE_AUTHOR="AGC Ikenegbu Assemblies of God"
PUBLIC_SITE_NAME="AGC Ikenegbu Assemblies of God"
PUBLIC_SITE_SHORT_NAME="AGC Ikenegbu"
PUBLIC_SITE_TAGLINE="Assemblies of God Church Owerri"
PUBLIC_SITE_DEFAULT_TITLE="AGC Ikenegbu | Assemblies of God Church Owerri - Worship & Community"
PUBLIC_SITE_DEFAULT_DESCRIPTION="AGC Ikenegbu Assemblies of God in Owerri, Nigeria - spirit-filled worship, Bible teaching, family ministries, and community outreach. Join us Sundays 8:00 AM & 10:30 AM."
PUBLIC_SITE_DEFAULT_OG_TITLE="AGC Ikenegbu | Assemblies of God Church Owerri"
PUBLIC_SITE_DEFAULT_OG_DESCRIPTION="Spirit-filled worship, Bible teaching, and community outreach in Owerri, Nigeria."
PUBLIC_SITE_LOGO_PATH=images/ag-logo.jpeg
PUBLIC_SITE_LOGO_VIDEO_PATH=videos/Create_a_cinematic_D_animatio.mp4
PUBLIC_SITE_WELCOME_VIDEO_PATH=videos/Create_a_cinematic_D_animatio.mp4
PUBLIC_SITE_WELCOME_VIDEO_LABEL="AGC Ikenegbu welcome video"

BRAND_EMAIL_FROM_NAME="Assemblies of God Church Ikenegbu"
BRAND_EMAIL_FROM_EMAIL=info@agikenebgu.org
BRAND_EMAIL_CHURCH_ADDRESS="11 Archdeacon, Dennis Street, Ikenegbu, Owerri, Imo State"
BRAND_EMAIL_CHURCH_PHONE="08034095171"
BRAND_EMAIL_CHURCH_WEBSITE="${APP_URL}"
BRAND_EMAIL_PASTOR_NAME="Pastor Emmanuel"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assemblies_of_god
DB_USERNAME=root
DB_PASSWORD=

# Hostinger Web Hosting cannot change the document root. It is always
# .../domains/agcikenegbu.org/public_html (this application root).
# Root index.php + .htaccess boot Laravel. Public URLs /site /portal /build
# are rewritten to public/site, public/portal, public/build. Do not copy
# public/site/uploads. See HOSTINGER.md.

# Hostinger production (agcikenegbu.org) — set these in the server .env, not locally:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://agcikenegbu.org
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=u238679323_agcikenegbu
# DB_USERNAME=u238679323_agcikenegbu
# DB_PASSWORD=          # MySQL user password from hPanel, not your Hostinger login

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Site traffic beacon (legacy public site → Laravel API during staging cutover)
TRAFFIC_IP_SALT=ag-ikenebgu-site-traffic-v1
TRAFFIC_GEO_LOOKUP=false
# Comma-separated origins allowed to POST /api/track-traffic (use * for staging)
TRAFFIC_BEACON_CORS_ORIGINS=*

PORTAL_MEDIA_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE
PORTAL_LEGACY_ADMIN_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE/portal
PORTAL_LEGACY_PUBLIC_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE
PORTAL_LEGACY_API_BASE=http://localhost/AG_IKENEGBU_CHURCH_WEBSITE/api
PORTAL_LEGACY_ROOT=C:/xampp/htdocs/AG_IKENEGBU_CHURCH_WEBSITE
# PORTAL_WEBSITE_PAGES_PATH=C:/xampp/htdocs/AG_IKENEGBU_CHURCH_WEBSITE/portal/storage/website-pages.json

# Google AdSense (public content pages only; denied on donate / member portal)
ADSENSE_ENABLED=true
ADSENSE_CLIENT_ID=ca-pub-4828740366189357

# Google Analytics 4 (public pages only; loads after analytics cookie consent)
GOOGLE_ANALYTICS_ID=

# Reverse geocoding for optional newsletter browser location (OpenStreetMap Nominatim)
GEOCODING_ENABLED=true
GEOCODING_TIMEOUT_SECONDS=3
GEOCODING_USER_AGENT="AGC-Ikenegbu-Newsletter/1.0 (contact@agikenebgu.org)"
